---
import '../styles/explorations.css';

interface Props {
  title?: string;
  description?: string;
  /** Share card, relative to the site root. Generated by `pnpm og`. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Draft or unlisted: keep it out of search while it is off the grid. */
  noindex?: boolean;
}

const {
  title = 'Explorations — Frank Young',
  description = 'Games, generative work and small experiments.',
  ogImage = '/og/home-dark.png',
  ogImageAlt =
    'A topographic contour drawing in fine lines on near-black, with the name Frank Young set in Bodoni.',
  noindex = false,
} = Astro.props;

/*
 * These pages had no og:image, no canonical and no Twitter card at all,
 * so all seven of them rendered as bare text when shared. Crawlers do not
 * resolve relative URLs — a path is silently dropped — so both are made
 * absolute against Astro.site.
 *
 * The dark card is the default here because the explorations are fixed
 * dark by design; the light one would misrepresent them.
 */
const ogImageUrl = new URL(ogImage, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {/* These pages are fixed dark by design, so color-scheme is
        declared rather than resolved — form controls, scrollbars and
        the browser's own chrome match without a theme script. */}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&display=swap"
    />

    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Frank Young" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Per-page head additions — the Quizzolator uses this to preload
        its subset specimen fonts. */}
    <slot name="head" />
  </head>

  <body class="bg-ink text-fg" style="color-scheme: dark;">
    <slot />
  </body>
</html>
