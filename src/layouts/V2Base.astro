---
import '../styles/v2.css';
import StructuredData from '../components/v2/StructuredData.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Emit the Person/WebSite JSON-LD. On the homepage only — the same
   * entity repeated on every page adds nothing and Google prefers one
   * canonical declaration.
   */
  structuredData?: boolean;
  /** Share card, relative to the site root. Generated by `pnpm og`. */
  ogImage?: string;
  /** Describes the card for anyone who cannot see it. */
  ogImageAlt?: string;
}

const {
  title = 'Frank Young — Product Design & Frontend Development',
  description =
    'Frank Young designs and builds clear, durable digital products for complicated domains — electric fleets, vehicle commerce, healthcare and everyday tools.',
  structuredData = false,
  ogImage = '/og/home-light.png',
  ogImageAlt =
    'A topographic contour drawing in fine grey lines on off-white paper, with the name Frank Young set in Bodoni.',
} = Astro.props;

/*
 * Crawlers do not resolve relative URLs — Facebook, LinkedIn and Slack all
 * require an absolute one, and silently show no image if given a path. new
 * URL() against Astro.site (set in astro.config.mjs) is what makes it
 * absolute, and it fails loudly at build time if `site` is ever removed.
 */
const ogImageUrl = new URL(ogImage, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {/*
      Theme resolution runs before first paint so the correct ground
      colour is committed with the first frame — no flash of the wrong
      theme. Stored choice wins over the system preference. Wrapped in
      try/catch because localStorage throws outright in some privacy
      modes; failing there must not take the page down with it.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('fy-theme');
          var system = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          var theme = stored === 'light' || stored === 'dark' ? stored : system;
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.setAttribute('data-theme-source', stored ? 'user' : 'system');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <meta name="theme-color" content="#fcfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&display=swap"
    />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Frank Young" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {/*
      og:image was missing entirely until now, which is why links to this
      site rendered as bare text in LinkedIn and Slack. The dimensions are
      not decoration: without them a crawler has to fetch and measure the
      file before it can lay the card out, and several of them simply skip
      the image instead.
    */}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* X reads its own namespace and ignores og:* for card type. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {structuredData && <StructuredData />}
  </head>

  <body>
    <slot />
  </body>
</html>
