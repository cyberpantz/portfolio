---
import ExpBase from '../../layouts/ExpBase.astro';
import { VISIBLE_EXPLORATIONS } from '../../data/explorations';
import { ExplorationIcon } from '../../components/ExplorationIcon';
import { Image } from 'astro:assets';

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<ExpBase
  title="Explorations — Frank Young"
  description="Games, generative work and small experiments. No brief, no client, no deadline."
>
  <a
    class="absolute top-0 -left-[9999px] z-[200] bg-fg px-6 py-4 text-[13px] tracking-[0.12em]
           uppercase text-ink focus:top-4 focus:left-4"
    href="#main">Skip to content</a
  >

  <header class="border-b border-rule">
    <div class="mx-auto flex min-h-14 max-w-[1320px] items-center px-5 sm:px-8">
      <a
        href="/"
        class="group/back inline-flex min-h-11 items-center gap-2.5 text-exp-micro font-medium
               tracking-[0.16em] uppercase text-fg-muted transition-colors hover:text-fg"
      >
        <span
          aria-hidden="true"
          class="inline-block transition-transform duration-500 ease-editorial
                 group-hover/back:-translate-x-1">←</span
        >
        Frank Young
      </a>
    </div>
  </header>

  <main id="main" class="mx-auto max-w-[1320px] px-5 pb-24 sm:px-8">
    <div class="border-b border-rule py-[clamp(56px,9vw,120px)]">
      <p class="mb-[clamp(20px,3vw,32px)] text-exp-micro font-medium tracking-[0.2em] uppercase text-fg-muted">
        <span class="mr-3.5 font-serif text-xl text-accent" aria-hidden="true">04</span>Explorations
      </p>

      <h1
        class="max-w-[16ch] font-serif text-[clamp(38px,7.6vw,104px)] leading-[0.94]
               tracking-[-0.026em] text-fg [text-wrap:balance]"
      >
        Things built <em class="not-italic text-accent">for fun.</em>
      </h1>

      <p class="mt-[clamp(24px,3vw,36px)] max-w-[56ch] text-[clamp(17px,1.5vw,21px)] leading-[1.5] text-exp-bright [text-wrap:pretty]">
        No brief, no client, no deadline, no stress. 
      </p>
    </div>

    <ul class="grid grid-cols-3 list-none max-lg:grid-cols-2 max-md:grid-cols-1">
      {VISIBLE_EXPLORATIONS.map((exp, i) => (
        <li class="contents">
          <a
            href={exp.url ?? '#'}
            class="exp-card group/exp flex flex-col gap-3.5 border-r border-b border-rule px-[clamp(20px,2.4vw,32px)]
                   pt-[clamp(26px,3vw,40px)] pb-[clamp(28px,3.4vw,44px)] text-fg
                   transition-colors duration-500 ease-editorial hover:bg-ink-surface
                   nth-[3n]:border-r-0
                   max-lg:nth-[3n]:border-r max-lg:nth-[2n]:border-r-0
                   max-md:border-r-0!"
          >
            <span class="flex items-center justify-between gap-3">
              <span class="flex items-baseline gap-3">
                <span class="font-serif text-sm italic text-accent" aria-hidden="true">{pad(i)}</span>
                <ExplorationIcon id={exp.id} size={18} />
              </span>
              <span class="text-exp-micro font-medium tracking-[0.16em] uppercase text-fg-muted">
                {exp.type}
              </span>
            </span>

            {exp.cover && (
              <span class="exp-thumb mt-1 block aspect-4/3 overflow-hidden border border-rule bg-ink-surface">
                <Image
                  class="size-full object-cover"
                  src={exp.cover}
                  alt={exp.coverAlt ?? ''}
                  widths={[420, 840]}
                  sizes="(max-width: 767px) 92vw, (max-width: 1023px) 46vw, 31vw"
                  loading="lazy"
                />
              </span>
            )}

            <h2 class="font-serif text-[clamp(22px,2.2vw,30px)] leading-[1.06] tracking-[-0.024em] text-fg">
              {exp.name}
            </h2>

            <p class="text-exp-body text-exp-muted [text-wrap:pretty]">{exp.desc}</p>

            <span class="mt-auto flex flex-wrap gap-x-3 gap-y-1.5 pt-4">
              {exp.tags.map((t) => (
                <span class="text-exp-micro tracking-[0.12em] uppercase text-exp-dim">{t}</span>
              ))}
            </span>

            <span
              class="inline-flex min-h-11 items-center gap-2.5 text-exp-micro font-medium
                     tracking-[0.16em] uppercase text-accent"
            >
              Open
              <span
                aria-hidden="true"
                class="inline-block transition-transform duration-500 ease-editorial
                       group-hover/exp:translate-x-[7px] group-focus-visible/exp:translate-x-[7px]"
                >→</span
              >
              {exp.needsRoom && (
                <span class="sr-only">— works best on a larger screen</span>
              )}
            </span>
          </a>
        </li>
      ))}

      <li
        class="flex flex-col gap-3.5 border-r border-b border-rule px-[clamp(20px,2.4vw,32px)]
               pt-[clamp(26px,3vw,40px)] pb-[clamp(28px,3.4vw,44px)]
               nth-[3n]:border-r-0 max-lg:nth-[3n]:border-r max-lg:nth-[2n]:border-r-0
               max-md:border-r-0!"
      >
        <span class="text-exp-micro font-medium tracking-[0.16em] uppercase text-fg-muted">
          Archives
        </span>
        <h2 class="font-serif text-[clamp(22px,2.2vw,30px)] leading-[1.06] tracking-[-0.024em] text-fg">
          More on the way
        </h2>
        <p class="text-exp-body text-exp-muted [text-wrap:pretty]">
          Digging through the archives to resurrect old experiments. A few things worth
          saving are getting dusted off.
        </p>
        <span class="mt-auto pt-4 text-exp-micro font-medium tracking-[0.16em] uppercase text-exp-dim">
          Coming soon
        </span>
      </li>
    </ul>

    <p class="mt-8 text-exp-note text-exp-dim md:hidden">
      Several of these want a larger screen and a keyboard.
    </p>
  </main>
</ExpBase>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<style>
  /*
   * Rise and resolve.
   *
   * At rest the tile is muted and sits flat; on hover it lifts a few
   * pixels, the rim brightens, and the picture resolves to full colour.
   * No rotation — the previous version tilted the tile, which keystoned
   * the SCREENSHOTS OF TEXT inside it into trapezoids, and distorted UI
   * reads as cheap however smooth the easing is.
   *
   * The two halves are deliberately out of step: the lift runs 420ms and
   * the colour 640ms, so the tile moves first and the picture catches up.
   * Matching them makes one blunt event; staggering them is most of what
   * separates this from a hover state that merely works.
   *
   * The zoom is on the IMAGE, inside the frame's overflow, so the tile's
   * edge stays a crisp rectangle while the picture breathes.
   *
   * Rest is muted, not monochrome. Full grayscale killed the one vivid
   * thumbnail in the grid, which is the card doing the most work to make
   * the section look alive.
   */
  .exp-thumb {
    transition:
      transform 420ms cubic-bezier(0.22, 0.8, 0.22, 1),
      border-color 420ms cubic-bezier(0.22, 0.8, 0.22, 1),
      box-shadow 420ms cubic-bezier(0.22, 0.8, 0.22, 1);
    will-change: transform;
  }

  /*
   * The drift is a long TRANSITION, not a keyframe animation.
   *
   * A @keyframes Ken Burns has to be switched on by :hover and then
   * vanishes the moment the pointer leaves, so the picture snaps back to
   * its start — the one frame of the whole effect that anybody notices.
   * Driving transform and object-position over five seconds instead
   * means the drift eases out exactly the way it eased in, from wherever
   * it had got to, and needs no keyframes at all.
   *
   * object-position is what makes it a PAN rather than just a zoom: the
   * image is object-fit: cover, so moving its origin slides the visible
   * window across the picture while the frame stays still.
   */
  .exp-thumb :global(img) {
    filter: grayscale(0.5) brightness(0.84) contrast(1.04);
    object-position: 50% 50%;
    transition:
      filter 640ms cubic-bezier(0.22, 0.8, 0.22, 1),
      transform 5200ms cubic-bezier(0.15, 0.6, 0.25, 1),
      object-position 5200ms cubic-bezier(0.15, 0.6, 0.25, 1);
    will-change: filter, transform, object-position;
  }

  .exp-card:hover .exp-thumb,
  .exp-card:focus-visible .exp-thumb {
    transform: translateY(-6px);
    /*
     * A brightened rim, not a cast shadow. Both places this runs are dark
     * grounds now — the index is bg-ink, and the homepage only shows these
     * in the dark theme — so a dark shadow under a dark tile does nothing.
     * The shadow stays only for the contact edge it gives the lift.
     */
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
  }

  .exp-card:hover .exp-thumb :global(img),
  .exp-card:focus-visible .exp-thumb :global(img) {
    filter: none;
    /* Enough zoom to give the pan somewhere to go without softening the
       screenshot — these are pixel art at heart. */
    transform: scale(1.11);
    object-position: 56% 44%;
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-thumb,
    .exp-thumb :global(img) {
      transition: filter 200ms linear, border-color 200ms linear;
    }
    .exp-card:hover .exp-thumb,
    .exp-card:focus-visible .exp-thumb {
      transform: none;
    }
    .exp-card:hover .exp-thumb :global(img),
    .exp-card:focus-visible .exp-thumb :global(img) {
      transform: none;
      object-position: 50% 50%;
    }
  }
</style>
