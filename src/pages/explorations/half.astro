---
import ExpBase from '../../layouts/ExpBase.astro';
import ExpChrome from '../../components/exp/ExpChrome.astro';
import Half from '../../experiments/half/Half';
import data from '../../data/half.json';

const total = `$${(data.summary.totalWealth / 1e12).toFixed(2)} trillion`;
---

<ExpBase
  title="Half — Frank Young"
  description={`Half, 2026 — the Giving Pledge asks the very rich for at least half. Sixteen years later, the twenty-five richest people alive hold ${total}. Charts compare their fortunes, promises, reported giving and available public filings, while marking what the record cannot establish.`}
>
  <ExpChrome name="Half" kind="Data" />
  <main id="main" class="exp-stage">
    <Half client:visible />
  </main>
</ExpBase>
