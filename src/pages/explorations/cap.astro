---
import ExpBase from '../../layouts/ExpBase.astro';
import ExpChrome from '../../components/exp/ExpChrome.astro';
import Cap from '../../experiments/cap/Cap';
import data from '../../data/cap.json';

/* The base is read from the data file even here, so the one number in the
   share text cannot go stale on its own. */
const base = `$${data.law.wageBase.toLocaleString('en-US')}`;
---

<ExpBase
  noindex
  title="The Cap — Frank Young"
  description={`The Cap, ${data.law.year} — Social Security tax stops on the day your wages reach ${base}. For most people that day never comes; for some it is in January. Enter an income and see the date. Every figure computed from the Federal Register, the US Code and public filings, none typed by hand.`}
>
  <ExpChrome name="The Cap" kind="Data" />
  <main id="main" class="exp-stage">
    <Cap client:visible />
  </main>
</ExpBase>
