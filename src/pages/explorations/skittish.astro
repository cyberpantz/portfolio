---
import ExpBase from '../../layouts/ExpBase.astro';
import ExpChrome from '../../components/exp/ExpChrome.astro';
import Skittish from '../../experiments/skittish/Skittish';
---

<ExpBase
  noindex
  title="Skittish — Frank Young"
  description="Skittish, 2026 — a hundred thousand particles settle into the silhouette of a sitting cat and move like cloth in a breeze. Reach for it and they flow away from your hand, then find their places again once you move on."
>
  <ExpChrome name="Skittish" kind="Toy" />
  <main id="main" class="exp-stage">
    <Skittish client:visible />
  </main>
</ExpBase>

<style>
  .exp-stage {
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(120% 70% at 50% 20%, #1a1a1d 0%, #131315 62%, #0b0b0c 100%);
  }
</style>
