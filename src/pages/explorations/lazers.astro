---
import ExpBase from '../../layouts/ExpBase.astro';
import ExpChrome from '../../components/exp/ExpChrome.astro';
import Lazers from '../../experiments/lazers/Lazers';
---

<ExpBase
  title="Lazers — Frank Young"
  description="Lazers, 2026 — a cat drawn entirely in points, rigged to a real skeleton, watching a red dot that follows your cursor. Take the dot to the floor and it stands up and stalks; bring it near a paw and the paw comes up, waits, and strikes."
>
  <ExpChrome name="Lazers" kind="Toy" />
  <main id="main" class="exp-stage">
    <Lazers client:visible />
  </main>
</ExpBase>

<style>
  .exp-stage {
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(120% 70% at 50% 20%, #1a1a1d 0%, #131315 62%, #0b0b0c 100%);
  }
</style>
