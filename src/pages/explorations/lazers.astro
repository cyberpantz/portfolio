---
import ExpBase from '../../layouts/ExpBase.astro';
import ExpChrome from '../../components/exp/ExpChrome.astro';
import Lazers from '../../experiments/lazers/Lazers';
---

<ExpBase
  title="Lazers — Frank Young"
  description="Lazers, 2026 — a cat made of points of light, with a real skeleton and one ambition: the red dot that follows your cursor. It stalks, it waits, it strikes. It has never caught the dot. It remains optimistic."
>
  <ExpChrome name="Lazers" kind="Toy" />
  <main id="main" class="exp-stage">
    <Lazers client:visible />
  </main>
</ExpBase>

<style>
  .exp-stage {
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(120% 70% at 50% 20%, #1a1a1d 0%, #131315 62%, #0b0b0c 100%);
  }
</style>
