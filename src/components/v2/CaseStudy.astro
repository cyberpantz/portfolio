---
import { Image, getImage } from 'astro:assets';
import type { ProjectV2 } from '../../data/projectsV2';
import CaseStudyLightbox from './CaseStudyLightbox';

interface Props {
  project: ProjectV2;
  /** h1 on its own routed page, h2 inside the dialog. */
  level?: 1 | 2;
  titleId?: string;
}

const { project: p, level = 2, titleId } = Astro.props;
const Title = level === 1 ? 'h1' : 'h2';
const NoteHeading = level === 1 ? 'h2' : 'h3';

/*
  Full-size sources for the lightbox, generated at build time.

  The inline plates top out at 1800px because they render in a 55vw column;
  the lightbox fills the viewport and can zoom past 1:1, so it gets its own
  2400px webp rather than reusing a column-sized srcset entry and going soft
  the moment anyone pushes in.
*/
const lightboxSlides = await Promise.all(
  p.shots.map(async (shot) => ({
    src: (await getImage({ src: shot.src, width: 2400, format: 'webp' })).src,
    alt: shot.alt,
    description: shot.caption,
  })),
);
---

{/*
  A magazine spread: the text column sticks while the plates scroll
  past it. Reading order in the markup is text then images, which is
  also the single-column order below lg — nothing needs reordering.
*/}
<div
  class="mx-auto grid max-w-spread grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] items-start
         gap-[clamp(40px,5vw,88px)] px-gut pt-[clamp(56px,6vw,96px)] pb-[clamp(64px,8vw,120px)]
         max-lg:grid-cols-1 max-lg:gap-[clamp(36px,6vw,56px)]"
>
  {/*
    align-self is start by default here, so a text column taller than
    the viewport scrolls with the page instead of clipping.
  */}
  <div data-cs-text class="sticky top-[clamp(56px,6vw,96px)] min-w-0 max-lg:static">
    <p
      class="mb-[clamp(18px,2.4vw,28px)] text-meta font-medium tracking-[0.2em] uppercase text-cs-muted"
    >
      Project {p.n} — {p.year}{p.status ? ` · ${p.status}` : ''}
    </p>

    <Title
      class="font-display text-cs-title font-normal tracking-[-0.032em] text-cs-1"
      id={titleId}
    >
      {p.name}
    </Title>

    <p class="mt-5 max-w-[30ch] font-display text-cs-tag italic text-cs-3">{p.tag}</p>

    <p class="mt-[clamp(24px,3vw,36px)] max-w-[58ch] text-base/[1.76] text-cs-2 [text-wrap:pretty]">
      {p.para}
    </p>

    <div
      class="mt-[clamp(32px,4vw,48px)] flex flex-col gap-[clamp(20px,2.4vw,30px)]
             border-t border-cs-hair pt-[clamp(24px,3vw,32px)]"
    >
      {p.notes.map((note) => (
        <div>
          <NoteHeading class="mb-2.5 text-meta font-medium tracking-[0.18em] uppercase text-cs-accent">
            {note.label}
          </NoteHeading>
          <p class="max-w-[52ch] text-caption text-cs-2 [text-wrap:pretty]">{note.body}</p>
        </div>
      ))}
    </div>

    <p
      class="mt-[clamp(28px,3.4vw,42px)] border-t border-cs-hair pt-[18px] text-meta/[1.7]
             tracking-[0.14em] uppercase text-cs-muted"
    >
      {p.stack}
    </p>

    {p.url && p.cta && (
      <a
        class="group/cta mt-5 inline-flex min-h-11 items-center gap-2.5 text-meta font-medium
               tracking-[0.16em] uppercase text-cs-accent hover:text-cs-accent-hi"
        href={p.url}
        target="_blank"
        rel="noopener"
      >
        {p.cta}
        <span
          aria-hidden="true"
          class="transition-transform duration-500 ease-editorial group-hover/cta:translate-x-[7px]"
          >→</span
        >
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}
  </div>

  <div class="flex min-w-0 flex-col gap-[clamp(32px,4vw,64px)]">
    {p.shots.length > 0 ? (
      p.shots.map((shot, i) => (
        <figure class="m-0">
          {/*
            A real button, not a click handler on the image. The plate has to
            be reachable by keyboard and announce what it does, and wrapping
            is the cheapest way to get focus, Enter/Space and a label for
            free. Without JS it is an inert button around an image that still
            renders — nothing is lost, nothing lies about being interactive
            beyond a cursor.

            widths/sizes emit a responsive srcset — the source PNGs
            are 2000–2600px wide and would otherwise ship whole.
          */}
          <button
            type="button"
            data-cs-group={p.id}
            data-cs-shot={i}
            aria-label={`View larger: ${shot.alt}`}
            class="group/plate block w-full cursor-zoom-in border-0 bg-transparent p-0"
          >
            <Image
              class="h-auto w-full border border-cs-hair transition-opacity duration-500
                     ease-editorial group-hover/plate:opacity-90"
              src={shot.src}
              alt={shot.alt}
              widths={[640, 900, 1200, 1600, 1800]}
              sizes="(max-width: 1024px) 100vw, 55vw"
              loading="lazy"
              decoding="async"
            />
          </button>
          <figcaption class="mt-3 text-meta/[1.6] tracking-[0.12em] uppercase text-cs-muted">
            {shot.caption}
          </figcaption>
        </figure>
      ))
    ) : (
      <p
        class="border border-dashed border-cs-hair px-[clamp(24px,4vw,48px)] py-[clamp(48px,8vw,96px)]
               text-center text-meta/[1.8] tracking-[0.16em] uppercase text-cs-muted"
      >
        No screens kept from this one
      </p>
    )}
  </div>
</div>

{/*
  client:idle, not client:load — the lightbox is a response to a click that
  has not happened yet, so it has no business competing with first paint. It
  is also skipped entirely when there is nothing to open.
*/}
{lightboxSlides.length > 0 && (
  <CaseStudyLightbox client:idle slides={lightboxSlides} group={p.id} />
)}
