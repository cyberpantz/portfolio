---
import SectionHead from './SectionHead.astro';
import { Image } from 'astro:assets';
import { VISIBLE_EXPLORATIONS, driftFor } from '../../data/explorations';

const pad = (i: number) => String(i + 1).padStart(2, '0');

const CELL =
  'flex flex-col gap-3.5 border-r border-b border-rule-2 px-[clamp(20px,2.4vw,32px)] ' +
  'pt-[clamp(26px,3vw,40px)] pb-[clamp(28px,3.4vw,44px)] transition-colors duration-500 ' +
  'ease-editorial nth-[3n]:border-r-0 ' +
  'max-xl:nth-[3n]:border-r max-xl:nth-[2n]:border-r-0 ' +
  'max-md:border-r-0! ';

const NAME = 'font-display text-exp font-normal tracking-[-0.024em] text-ink';
const DESC = 'text-caption text-ink-3 [text-wrap:pretty]';
const KIND = 'text-meta font-medium tracking-[0.16em] uppercase text-muted';
const MORE = 'mt-auto pt-[18px] text-meta font-medium tracking-[0.16em] uppercase';
---

<section
  id="explorations"
  aria-labelledby="h-exp"
  class="mx-auto max-w-shell px-gut py-[clamp(80px,12vw,160px)]"
>
  <SectionHead num="04" id="h-exp" label="Explorations" />

  <div class="reveal mb-[clamp(36px,5vw,60px)] max-w-[62ch]">
    <p class="text-standfirst tracking-[-0.007em] text-ink-2 [text-wrap:pretty]">
      Games, generative work, small experiments. No brief, no client, no deadlines, no stress.
    </p>
  </div>

  {/*
    Each card is a real anchor. The mock rendered a div with a
    "Read more →" that went nowhere and was not focusable, so its
    :focus-within rule could never fire.
  */}
  <div class="reveal grid grid-cols-3 border-t border-ink max-xl:grid-cols-2 max-md:grid-cols-1">
    {VISIBLE_EXPLORATIONS.map((exp, i) => (
      <a class={`exp-card group/exp text-ink hover:bg-paper-2 ${CELL}`} href={exp.url ?? '/explorations'}>
        <span class="flex items-baseline justify-between gap-3">
          <span class="font-display text-sm italic text-accent" aria-hidden="true">{pad(i)}</span>
          <span class={KIND}>{exp.type}</span>
        </span>
        {exp.cover && (
          <span
            class="exp-thumb mt-1 block aspect-4/3 overflow-hidden border border-rule-2 bg-paper-2"
            style={`--dx:${driftFor(i).x};--dy:${driftFor(i).y}`}
          >
            <Image
              class="size-full object-cover"
              src={exp.cover}
              alt={exp.coverAlt ?? ''}
              widths={[420, 840]}
              sizes="(max-width: 767px) 92vw, (max-width: 1279px) 46vw, 31vw"
              loading="lazy"
            />
          </span>
        )}
        <h3 class={NAME}>{exp.name}</h3>
        <p class={DESC}>{exp.desc}</p>
        <span class={`${MORE} text-accent`}>
          Open
          <span
            aria-hidden="true"
            class="inline-block transition-transform duration-500 ease-editorial
                   group-hover/exp:translate-x-[7px] group-focus-visible/exp:translate-x-[7px]"
            >→</span
          >
        </span>
      </a>
    ))}

    <div class={CELL}>
      <span class="flex items-baseline justify-between gap-3">
        <span class={KIND}>Archives</span>
      </span>
      <h3 class={NAME}>More on the way</h3>
      <p class={DESC}>
        Digging through the archives to resurrect old experiments. A few things worth
        saving are getting dusted off.
      </p>
      <span class={`${MORE} text-muted`}>Coming soon</span>
    </div>
  </div>
</section>

<style>
  /*
   * Dark theme only, on the homepage.
   *
   * Five of the six thumbnails are near-black rectangles — the
   * experiments are themselves dark-ground pieces — and on this
   * section's paper they stop reading as pictures and start reading as
   * heavy blocks punched into the grid. In the dark theme they sit in
   * the page instead of fighting it.
   *
   * The explorations index keeps them in both, because that page is
   * bg-ink regardless of this toggle.
   *
   * Written as the same pair v2.css uses for every other themed rule:
   * the explicit attribute, plus the system query guarded against an
   * explicit light choice, so this still behaves if the inline theme
   * script never runs. Hidden with display:none rather than opacity so
   * the lazy images are never fetched in the light theme at all.
   */
  .exp-thumb {
    display: none;
  }

  :root[data-theme='dark'] .exp-thumb {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .exp-thumb {
      display: block;
    }
  }

  /*
   * Rise and resolve.
   *
   * At rest the tile is muted and sits flat; on hover it lifts a few
   * pixels, the rim brightens, and the picture resolves to full colour.
   * No rotation — the previous version tilted the tile, which keystoned
   * the SCREENSHOTS OF TEXT inside it into trapezoids, and distorted UI
   * reads as cheap however smooth the easing is.
   *
   * The two halves are deliberately out of step: the lift runs 420ms and
   * the colour 640ms, so the tile moves first and the picture catches up.
   * Matching them makes one blunt event; staggering them is most of what
   * separates this from a hover state that merely works.
   *
   * The zoom is on the IMAGE, inside the frame's overflow, so the tile's
   * edge stays a crisp rectangle while the picture breathes.
   *
   * Rest is muted, not monochrome. Full grayscale killed the one vivid
   * thumbnail in the grid, which is the card doing the most work to make
   * the section look alive.
   */
  .exp-thumb {
    transition:
      transform 420ms cubic-bezier(0.22, 0.8, 0.22, 1),
      border-color 420ms cubic-bezier(0.22, 0.8, 0.22, 1),
      box-shadow 420ms cubic-bezier(0.22, 0.8, 0.22, 1);
    will-change: transform;
  }

  /*
   * The drift is a long TRANSITION, not a keyframe animation.
   *
   * A @keyframes Ken Burns has to be switched on by :hover and then
   * vanishes the moment the pointer leaves, so the picture snaps back to
   * its start — the one frame of the whole effect that anybody notices.
   * Driving transform and object-position over five seconds instead
   * means the drift eases out exactly the way it eased in, from wherever
   * it had got to, and needs no keyframes at all.
   *
   * object-position is what makes it a PAN rather than just a zoom: the
   * image is object-fit: cover, so moving its origin slides the visible
   * window across the picture while the frame stays still.
   */
  .exp-thumb :global(img) {
    filter: grayscale(0.5) brightness(0.84) contrast(1.04);
    transform: scale(1) translate(0%, 0%);
    transition:
      filter 640ms cubic-bezier(0.22, 0.8, 0.22, 1),
      transform 5200ms cubic-bezier(0.15, 0.6, 0.25, 1);
    will-change: filter, transform;
  }

  .exp-card:hover .exp-thumb,
  .exp-card:focus-visible .exp-thumb {
    transform: translateY(-6px);
    /*
     * A brightened rim, not a cast shadow. Both places this runs are dark
     * grounds now — the index is bg-ink, and the homepage only shows these
     * in the dark theme — so a dark shadow under a dark tile does nothing.
     * The shadow stays only for the contact edge it gives the lift.
     */
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
  }

  .exp-card:hover .exp-thumb :global(img),
  .exp-card:focus-visible .exp-thumb :global(img) {
    filter: none;
    /*
     * The zoom exists to CREATE the room the pan moves within: at 1.16
     * the image overhangs its frame by 8% a side, and the translate
     * slides inside that. --dx/--dy come from the drift table, so each
     * card pulls a different way.
     *
     * This was object-position before, which did nothing at all: the
     * images are 4:3 inside a 4:3 frame with object-fit: cover, so there
     * is no overflow for it to move and the "pan" was only ever a zoom.
     * translate works on the rendered box and pans for real.
     */
    transform: scale(1.16) translate(var(--dx, 0%), var(--dy, 0%));
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-thumb,
    .exp-thumb :global(img) {
      transition: filter 200ms linear, border-color 200ms linear;
    }
    .exp-card:hover .exp-thumb,
    .exp-card:focus-visible .exp-thumb {
      transform: none;
    }
    .exp-card:hover .exp-thumb :global(img),
    .exp-card:focus-visible .exp-thumb :global(img) {
      transform: none;
    }
  }
</style>
