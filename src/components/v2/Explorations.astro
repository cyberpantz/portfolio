---
import SectionHead from './SectionHead.astro';
import { Image } from 'astro:assets';
import { VISIBLE_EXPLORATIONS } from '../../data/explorations';

const pad = (i: number) => String(i + 1).padStart(2, '0');

const CELL =
  'flex flex-col gap-3.5 border-r border-b border-rule-2 px-[clamp(20px,2.4vw,32px)] ' +
  'pt-[clamp(26px,3vw,40px)] pb-[clamp(28px,3.4vw,44px)] transition-colors duration-500 ' +
  'ease-editorial nth-[3n]:border-r-0 ' +
  'max-xl:nth-[3n]:border-r max-xl:nth-[2n]:border-r-0 ' +
  'max-md:border-r-0! ';

const NAME = 'font-display text-exp font-normal tracking-[-0.024em] text-ink';
const DESC = 'text-caption text-ink-3 [text-wrap:pretty]';
const KIND = 'text-meta font-medium tracking-[0.16em] uppercase text-muted';
const MORE = 'mt-auto pt-[18px] text-meta font-medium tracking-[0.16em] uppercase';
---

<section
  id="explorations"
  aria-labelledby="h-exp"
  class="mx-auto max-w-shell px-gut py-[clamp(80px,12vw,160px)]"
>
  <SectionHead num="04" id="h-exp" label="Explorations" />

  <div class="reveal mb-[clamp(36px,5vw,60px)] max-w-[62ch]">
    <p class="text-standfirst tracking-[-0.007em] text-ink-2 [text-wrap:pretty]">
      Games, generative work, small experiments. No brief, no client, no deadlines, no stress.
    </p>
  </div>

  {/*
    Each card is a real anchor. The mock rendered a div with a
    "Read more →" that went nowhere and was not focusable, so its
    :focus-within rule could never fire.
  */}
  <div class="reveal grid grid-cols-3 border-t border-ink max-xl:grid-cols-2 max-md:grid-cols-1">
    {VISIBLE_EXPLORATIONS.map((exp, i) => (
      <a class={`exp-card group/exp text-ink hover:bg-paper-2 ${CELL}`} href={exp.url ?? '/explorations'}>
        <span class="flex items-baseline justify-between gap-3">
          <span class="font-display text-sm italic text-accent" aria-hidden="true">{pad(i)}</span>
          <span class={KIND}>{exp.type}</span>
        </span>
        {exp.cover && (
          <span class="exp-thumb mt-1 block aspect-4/3 overflow-hidden border border-rule-2 bg-paper-2">
            <Image
              class="size-full object-cover"
              src={exp.cover}
              alt={exp.coverAlt ?? ''}
              widths={[420, 840]}
              sizes="(max-width: 767px) 92vw, (max-width: 1279px) 46vw, 31vw"
              loading="lazy"
            />
          </span>
        )}
        <h3 class={NAME}>{exp.name}</h3>
        <p class={DESC}>{exp.desc}</p>
        <span class={`${MORE} text-accent`}>
          Open
          <span
            aria-hidden="true"
            class="inline-block transition-transform duration-500 ease-editorial
                   group-hover/exp:translate-x-[7px] group-focus-visible/exp:translate-x-[7px]"
            >→</span
          >
        </span>
      </a>
    ))}

    <div class={CELL}>
      <span class="flex items-baseline justify-between gap-3">
        <span class={KIND}>Archives</span>
      </span>
      <h3 class={NAME}>More on the way</h3>
      <p class={DESC}>
        Digging through the archives to resurrect old experiments. A few things worth
        saving are getting dusted off.
      </p>
      <span class={`${MORE} text-muted`}>Coming soon</span>
    </div>
  </div>
</section>

<style>
  /*
   * Same treatment as the explorations index: flat and precise at rest,
   * lifted into a small rotation on hover, so the movement rewards
   * pointing rather than shouting from a static grid.
   *
   * The lift differs from the index's, and deliberately. That page is
   * bg-ink, where a cast shadow is invisible and the tile has to be
   * separated with a brightened rim. This section is on paper, so an
   * actual shadow does the work and the rim DARKENS instead. Copying the
   * dark-ground version here would have produced a hover state that
   * looked like nothing happened.
   */
  .exp-card {
    perspective: 1200px;
  }

  /*
   * Dark theme only, on the homepage.
   *
   * Five of the six thumbnails are near-black rectangles — the
   * experiments are themselves dark-ground pieces — and on this
   * section's paper they stop reading as pictures and start reading as
   * heavy blocks punched into the grid. In the dark theme they sit in
   * the page instead of fighting it.
   *
   * The explorations index keeps them in both, because that page is
   * bg-ink regardless of this toggle.
   *
   * Written as the same pair v2.css uses for every other themed rule:
   * the explicit attribute, plus the system query guarded against an
   * explicit light choice, so this still behaves if the inline theme
   * script never runs. Hidden with display:none rather than opacity so
   * the lazy images are never fetched in the light theme at all.
   */
  .exp-thumb {
    display: none;
  }

  :root[data-theme='dark'] .exp-thumb {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .exp-thumb {
      display: block;
    }
  }

  .exp-thumb {
    transform-origin: 50% 68%;
    transition:
      transform 620ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 620ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }

  .exp-card:hover .exp-thumb,
  .exp-card:focus-visible .exp-thumb {
    transform: rotateX(7deg) rotateY(-11deg) scale(1.045);
    border-color: rgba(0, 0, 0, 0.26);
    box-shadow: 0 20px 40px rgba(20, 18, 14, 0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-thumb {
      transition: border-color 200ms linear;
    }
    .exp-card:hover .exp-thumb,
    .exp-card:focus-visible .exp-thumb {
      transform: none;
    }
  }
</style>
