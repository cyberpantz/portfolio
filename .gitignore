# build output
dist/
.astro/

# deps
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env
.env
.env.production
.env.local

# editor
.vscode/
.idea/
.DS_Store

# OS
Thumbs.db
.superpowers/

# claude code local settings
.claude/settings.local.json

# Failure evidence from `pnpm shots` — a recipe that cannot find what it
# came to photograph dumps the page here so you can see what it saw.
# Useful locally, never something to commit.
src/assets/explorations/FAILED-*.png

# Raw source data for the insurance piece: 15MB, one download from
# Treasury, reproducible. `/data/` is anchored to the repo root on
# purpose — an unanchored `data/` also matches src/data/ and silently
# stops every data module in the project from being tracked.
/data/
src/data/raw/

# esbuild side-output from the test bundler. It was committed once by
# accident and then showed up as a diff on every test run.
src/experiments/*/__tests__/.bundle.*

# Third-party reference assets. Things downloaded to look at and measure
# against — not to ship. A personal-use-licensed model is fine to study on
# a laptop and is not fine in a public repo, and `git add -A` does not know
# the difference.
docs/resources/Cat_v1_L3*/
docs/resources/Cat/
docs/resources/**/*.obj
docs/resources/**/*.fbx
docs/resources/**/*.mtl

# Python bytecode from the bake scripts
__pycache__/
*.pyc
